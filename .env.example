HOST=0.0.0.0
PORT=8787
PUBLIC_BASE_URL=https://bot.example.com
LOG_LEVEL=info
MAX_BODY_BYTES=1048576
IDEMPOTENCY_TTL_SECONDS=86400
BOT_STORE_FILE=./data/state/bots.json
PLATFORM_SETTINGS_FILE=./data/state/platform-settings.json
SKILL_STORE_FILE=./data/state/skills.json
TRACE_LIMIT=250
CONVERSATION_MEMORY_TURNS=12

# Durable conversation/ticket ledger. SQLite is local/single-node persistence.
# Keep this file on persistent storage and migrate Bot Hub state to PostgreSQL before multi-replica scale.
CONVERSATION_DB_FILE=./data/state/conversations.sqlite
CONVERSATION_RETENTION_DAYS=30
CONVERSATION_MAX_MESSAGE_CHARS=8000

# Admin management surface.
# Desktop embedded runtime is loopback-only and does not use this server gate.
BOT_HUB_ADMIN_USER=admin
BOT_HUB_ADMIN_TOKEN=

# Hosted console origins allowed to call management APIs on the runtime.
WEB_CONSOLE_ORIGINS=https://customer-service-bot-zeta.vercel.app

# Encrypted provider credential vault.
# Production VPS must use a long random master key. Desktop uses a generated local key file.
CREDENTIAL_VAULT_FILE=./data/state/credentials.json
CREDENTIAL_VAULT_MASTER_KEY=
CREDENTIAL_VAULT_LOCAL_KEY_FILE=./data/state/credentials.key
CREDENTIAL_VAULT_ALLOW_LOCAL_KEY=false

# v0.8 AI Connections: non-secret routing/account state lives here; provider secrets remain in Credential Vault.
AI_CONNECTION_STORE_FILE=./data/state/ai-connections.json
AI_CONNECTION_TIMEOUT_MS=20000
AI_OAUTH_SESSION_TTL_SECONDS=600

# Optional official Google OAuth client for Gemini API authorization.
# API-key mode works without these values. Never use Google browser cookies or consumer Gemini sessions.
GEMINI_OAUTH_CLIENT_ID=
GEMINI_OAUTH_CLIENT_SECRET=
GEMINI_OAUTH_REDIRECT_URI=
GEMINI_OAUTH_SCOPES=openid,email,https://www.googleapis.com/auth/cloud-platform

# Public web chat widget. Cross-origin embedding is deny-by-default until origins are listed.
WEB_WIDGET_ENABLED=true
WEB_WIDGET_ALLOWED_ORIGINS=
WEB_WIDGET_MAX_MESSAGE_CHARS=2000
WEB_WIDGET_TOKEN_TTL_SECONDS=900
WEB_WIDGET_SIGNING_KEY=

CONNECT_SESSION_TTL_SECONDS=600

# Optional official provider authorization URL templates used by QR handoff.
# Supported placeholders: {state} and {redirectUri}.
# These do not turn personal Zalo/Facebook/TikTok accounts into messaging bots.
CONNECT_ZALO_AUTH_URL_TEMPLATE=
CONNECT_FACEBOOK_AUTH_URL_TEMPLATE=
CONNECT_TIKTOK_AUTH_URL_TEMPLATE=
CONNECT_TELEGRAM_HELP_URL=https://t.me/BotFather

# Docker / VPS edge and n8n persistence
DEPLOYMENT_MODE=free-local
BOT_DOMAIN=bot.example.com
N8N_DOMAIN=n8n.example.com
POSTGRES_PASSWORD=change-me-before-production
N8N_ENCRYPTION_KEY=replace-with-a-long-random-secret

# Vercel hosted-console bridge. BOT_RUNTIME_URL must point to the real public HTTPS runtime.
BOT_RUNTIME_URL=
BOT_RUNTIME_ADMIN_USER=admin
BOT_RUNTIME_ADMIN_TOKEN=
BOT_RUNTIME_STRICT=false
VERCEL_PREVIEW_SIGNING_KEY=

# Legacy environment AI route. This remains a fallback for existing installations.
# New installations should prefer AI Connections in the Bot Hub UI so credentials are verified and encrypted.
AI_PROVIDER_NAME=primary
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_TIMEOUT_MS=20000
AI_SYSTEM_PROMPT=You are a concise, helpful customer-service assistant. Never invent order status or policy facts.
AI_FALLBACKS_JSON=[]

# n8n event bridge
N8N_WEBHOOK_URL=
N8N_SHARED_SECRET=

# Telegram Bot / approved Telegram Business connection
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# Facebook Messenger uses a Page / approved professional messaging surface, not a personal profile inbox.
FACEBOOK_VERIFY_TOKEN=
FACEBOOK_APP_SECRET=
FACEBOOK_PAGE_ACCESS_TOKEN=
FACEBOOK_GRAPH_VERSION=v24.0

# Zalo OA only for customer-service messaging. Zalo personal/social login is identity-only in Bot Hub.
ZALO_OA_ACCESS_TOKEN=
ZALO_SEND_URL=
ZALO_WEBHOOK_SECRET=

# TikTok. Login/account authorization does not imply generic DM send permission.
TIKTOK_CLIENT_SECRET=
TIKTOK_SEND_URL=
TIKTOK_ACCESS_TOKEN=
TIKTOK_SIGNATURE_TOLERANCE_SECONDS=300

# Knowledge index
KNOWLEDGE_ROOT=./data/repos
KNOWLEDGE_MAX_FILES=2500
KNOWLEDGE_MAX_FILE_BYTES=262144
