HOST=0.0.0.0
PORT=8787
PUBLIC_BASE_URL=https://bot.example.com
LOG_LEVEL=info
MAX_BODY_BYTES=1048576
IDEMPOTENCY_TTL_SECONDS=86400
BOT_STORE_FILE=./data/state/bots.json
PLATFORM_SETTINGS_FILE=./data/state/platform-settings.json
SKILL_STORE_FILE=./data/state/skills.json
TRACE_LIMIT=250
CONVERSATION_MEMORY_TURNS=12

# Admin management surface.
# Desktop embedded runtime is loopback-only and does not use this server gate.
# For Docker/VPS set a long random token; vps-bootstrap.sh generates one automatically.
BOT_HUB_ADMIN_USER=admin
BOT_HUB_ADMIN_TOKEN=

CONNECT_SESSION_TTL_SECONDS=600

# Optional official OAuth URL templates used by QR handoff.
# Supported placeholders: {state} and {redirectUri}
CONNECT_ZALO_AUTH_URL_TEMPLATE=
CONNECT_FACEBOOK_AUTH_URL_TEMPLATE=
CONNECT_TIKTOK_AUTH_URL_TEMPLATE=
CONNECT_TELEGRAM_HELP_URL=https://t.me/BotFather

# Docker / VPS edge and n8n persistence
BOT_DOMAIN=bot.example.com
N8N_DOMAIN=n8n.example.com
POSTGRES_PASSWORD=change-me-before-production
N8N_ENCRYPTION_KEY=replace-with-a-long-random-secret

# AI router. Primary route uses these four values.
AI_PROVIDER_NAME=primary
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_TIMEOUT_MS=20000
AI_SYSTEM_PROMPT=You are a concise, helpful customer-service assistant. Never invent order status or policy facts.
# Optional ordered OpenAI-compatible fallback candidates. Keep secrets only in .env/secret storage.
# Example: [{"name":"backup","baseUrl":"https://provider.example/v1","apiKey":"...","model":"..."}]
AI_FALLBACKS_JSON=[]

# n8n event bridge
N8N_WEBHOOK_URL=
N8N_SHARED_SECRET=

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# Facebook Messenger
FACEBOOK_VERIFY_TOKEN=
FACEBOOK_APP_SECRET=
FACEBOOK_PAGE_ACCESS_TOKEN=
FACEBOOK_GRAPH_VERSION=v24.0

# Zalo OA
ZALO_OA_ACCESS_TOKEN=
# Configure the approved/current OA send endpoint from Zalo Developers for your app.
ZALO_SEND_URL=
ZALO_WEBHOOK_SECRET=

# TikTok
TIKTOK_CLIENT_SECRET=
# Public TikTok developer webhooks are event webhooks. Messaging outbound requires an approved product/capability.
TIKTOK_SEND_URL=
TIKTOK_ACCESS_TOKEN=
TIKTOK_SIGNATURE_TOLERANCE_SECONDS=300

# Knowledge index
KNOWLEDGE_ROOT=./data/repos
KNOWLEDGE_MAX_FILES=2500
KNOWLEDGE_MAX_FILE_BYTES=262144
